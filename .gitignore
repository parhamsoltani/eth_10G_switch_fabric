##############################################
##      .gitignore for Vivado IP Cores      ##
##############################################
# src/ip/*/*

# !src/ip/*/*.xci
# !src/ip/mmcm_sys_clk/*.v

src/ip/*/Xil_generated/*
src/ip/ila/*/Xil_generated/*

# Whitelists externals
!src/ip/submodule/*

# Whitelist desired Non-Xilinx IPs here.
!src/ip/gtx_backplane/*


##############################################
##   .gitignore for Vivado (Project Mode)   ##
##############################################
prj/*

##############################################
## .gitignore for Vivado (Non-project Mode) ##
##############################################
scr/build_hw/.Xil/*
scr/build_hw/vivado.log
scr/build_hw/*.txt

scr/dbg_assistant/*
!scr/dbg_assistant/*.bat
!scr/dbg_assistant/*.h

scr/dbg_mux_gen/*/ip/*
!scr/dbg_mux_gen/*/ip/*.xci
!scr/dbg_mux_gen/*/ip/*.dcp

scr/save_configs/config_generator/configs/*
!scr/save_configs/config_generator/configs/manifest.json
!scr/save_configs/config_generator/configs/manifest_sweep.json

out/reports/*
# !out/reports/postroutePhysopt
# out/reports/postroutePhysopt/*
# !out/reports/postroutePhysopt/*.rpt

out/hw_history/*
!out/hw_history/config_hist.csv

out/products/*
# !out/products/bitgen
# out/products/bitgen/*
# !out/products/bitgen/*.bit

# Additional build outputs (QoS sweep results)
out/timing_analysis/*
out/qos_reports/*
out/qos_impact_analysis.csv


##############################################
##         .gitignore for Modelsim          ##
##############################################
sim/*
!sim/tb
!sim/scr
!sim/*.tcl
!sim/*.do
!sim/*.bat
!sim/model
!sim/hvl
!sim/ip
!sim/inc

# Memory initialization files (generated by synth.pre.tcl)
src/inc/mem_init/*
sim/mem_init_*.mem

# Simulation work library and logs
sim/work/
sim/wlf/
sim/wave/
sim/*.wlf
sim/*.vcd
sim/vsim.dbg
sim/vsim_stacktrace.vstf
sim/transcript
sim/transcript*.log
sim/*.vstf


##############################################
##  Vivado Logs and Journals (Root Dir)    ##
##############################################
*.jou
*.log
*.backup.jou
*.backup.log
vivado*.jou
vivado*.log
vivado_*.backup.jou
vivado_*.backup.log

# Vivado temp directories in root
.Xil/
NA/

# Vivado project artifacts (if accidentally created in root)
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/
*.srcs/
*.xpr


##############################################
##    Vivado Build Outputs (Root Dir)      ##
##############################################
# Build directory (generated by vivado_qos_build_2019.tcl)
vivado_build/

# Design checkpoints and bitstreams
*.dcp
*.bit
*.ltx
*.bin
*.mcs
*.prm

# Reports (if generated in root)
*.rpt
*.vds
*.pb
*.wdb
*.wcfg

# Switch fabric directory (appears to be build artifact)
switch_fabric/


##############################################
##       Regression Test Results           ##
##############################################
regression_results_*/
scr/regression/regression_results_*/


##############################################
##      Python and Editor Artifacts        ##
##############################################
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
ENV/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


